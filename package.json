{
  "name": "construction-opportunity-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-backed, explainable opportunity radar for Construction and HoReCa.",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "postinstall": "pnpm --filter @radar/db db:generate",
    "dev": "tsx --tsconfig tsconfig.typecheck.json --env-file-if-exists=.env --watch apps/api/src/main.ts",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "bot:dev": "tsx --tsconfig tsconfig.typecheck.json --env-file-if-exists=.env --watch apps/bot/src/main.ts",
    "bot:start": "node --env-file-if-exists=.env apps/bot/dist/main.js",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait postgres",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @radar/db db:generate",
    "db:validate": "pnpm --filter @radar/db db:validate",
    "db:migrate:dev": "pnpm --filter @radar/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @radar/db db:migrate:deploy",
    "db:seed": "pnpm --filter @radar/db db:seed",
    "fixtures:generate": "node scripts/generate-ingestion-fixtures.mjs",
    "fixtures:ingest": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/ingest-fixtures.ts",
    "fixtures:normalize": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/normalize-fixtures.ts",
    "fixtures:deduplicate": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/deduplicate-fixtures.ts",
    "fixtures:classify": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/classify-fixtures.ts",
    "process:fixtures": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/process-fixtures.ts",
    "evals:generate": "node scripts/generate-eval-gold-v1.mjs",
    "evals:validate": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/validate-eval-dataset.ts",
    "benchmark:ai": "tsx --tsconfig tsconfig.typecheck.json apps/cli/src/benchmark-ai.ts",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" \"vitest*.config.ts\" --max-warnings 0",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"fixtures/**/*.json\" \"*.{json,mjs,ts,yaml,yml}\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.mjs\" \"fixtures/**/*.json\" \"*.{json,mjs,ts,yaml,yml}\"",
    "typecheck": "tsc --project tsconfig.typecheck.json --pretty false",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "build": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
