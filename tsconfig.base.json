{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "baseUrl": ".",
    "paths": {
      "@radar/application": ["packages/application/src/index.ts"],
      "@radar/config": ["packages/config/src/index.ts"],
      "@radar/contracts": ["packages/contracts/src/index.ts"],
      "@radar/core": ["packages/core/src/index.ts"],
      "@radar/db": ["packages/db/src/index.ts"],
      "@radar/observability": ["packages/observability/src/index.ts"],
      "@radar/source-adapters": ["packages/adapters/sources/src/index.ts"]
    }
  }
}
