{
  "name": "@radar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma7 generate --config prisma.config.ts",
    "db:validate": "prisma7 validate --config prisma.config.ts",
    "db:migrate:dev": "prisma7 migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma7 migrate deploy --config prisma.config.ts",
    "db:seed": "prisma7 db seed --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radar/application": "workspace:*",
    "@radar/core": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@radar/ai-adapters": "workspace:*",
    "@radar/contracts": "workspace:*",
    "@radar/source-adapters": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.18.0",
    "prisma": "npm:@prisma/prisma7@7.10.0"
  }
}
